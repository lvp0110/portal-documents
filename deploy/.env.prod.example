# Приватный IP prodfront, доступный только gateway-01.
FRONTEND_BIND_IP=10.0.0.249
FRONTEND_HOST_PORT=3009

# По умолчанию frontend сохраняет документы локально в IndexedDB.
VITE_DOCUMENTS_API_URL=
DOCUMENTS_API_URL=

# Чтобы включить внешний API, установите ОБЕ переменные и пересоберите frontend:
# VITE_DOCUMENTS_API_URL=/api
# DOCUMENTS_API_URL=http://prodbackend.mcs.local:3005/<api-base-path>
# Frontend удалит `/api` и добавит `/documents`, `/catalogs` и остальные пути.
REQUEST_TIMEOUT_MS=1800000
